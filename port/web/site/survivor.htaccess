# Warcraft Survivors on Apache shared hosting (OVH): copied as .htaccess.

# The engine uses WebAssembly threads (SharedArrayBuffer), which browsers
# allow only on a cross-origin isolated page.
<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # A new data/files.json must reach players at once (it decides re-downloads).
    <Files "files.json">
        Header set Cache-Control "no-cache"
    </Files>
    # The page, its scripts and index.wasm must come from the same upload: a
    # cached old index.js with a new index.wasm leaves a black screen. They are
    # revalidated on every load (an unchanged file costs a 304, not a download).
    <FilesMatch "\.(html|js|wasm|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/wasm .wasm
AddType application/manifest+json .webmanifest

# index.wasm (engine + scripts, re-downloaded after every update) gzips from
# 8.5 to 4.8 MB. Not the data archives: their files are compressed already.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/wasm application/javascript text/javascript text/html application/json application/manifest+json
</IfModule>

# Isolation (and so the game) needs HTTPS.
RewriteEngine On
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
